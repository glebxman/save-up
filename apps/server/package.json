{
  "name": "@finance-twa/server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "npm --prefix ../.. run dev",
    "dev:server": "tsx watch src/server.ts",
    "dev:bot": "tsx watch src/bot.ts",
    "start": "pnpm exec drizzle-kit migrate && node dist/src/server.js",
    "start:bot": "node dist/src/bot.js",
    "build": "pnpm exec tsc -p tsconfig.json",
    "typecheck": "pnpm exec tsc -p tsconfig.json --noEmit",
    "db:generate": "pnpm exec drizzle-kit generate",
    "db:migrate": "pnpm exec drizzle-kit migrate"
  },
  "dependencies": {
    "@fastify/cors": "^9.0.1",
    "@fastify/helmet": "^11.1.1",
    "@fastify/rate-limit": "^9.1.0",
    "@finance-twa/shared-types": "workspace:*",
    "dotenv": "^16.4.5",
    "drizzle-orm": "latest",
    "fastify": "^4.28.1",
    "fastify-plugin": "^5.0.1",
    "ioredis": "^5.4.1",
    "pg": "^8.12.0",
    "pino": "^10.3.1",
    "pino-pretty": "^13.1.3",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@types/pg": "^8.11.10",
    "@types/pino": "^7.0.5",
    "drizzle-kit": "latest",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3"
  }
}
